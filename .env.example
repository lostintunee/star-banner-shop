# Сайт
PORT=3000
SESSION_SECRET=change-this-to-a-random-string
ADMIN_PASSWORD=change-me

# Telegram-бот (создать через @BotFather -> /newbot)
BOT_TOKEN=
BOT_USERNAME=your_bot_username_without_at
# Ваш Telegram ID (узнать через @userinfobot) - только этот пользователь может
# загружать контент и назначать цену в боте
ADMIN_TELEGRAM_ID=

# Публичный HTTPS-адрес сайта (после деплоя), например https://mysite.com
# Нужен только чтобы в карточке оплаты показывалась картинка баннера.
# Пока сайт крутится на localhost - оставьте пустым, Telegram не сможет
# скачать картинку с localhost.
PUBLIC_BASE_URL=
